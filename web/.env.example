# Data location. By default the app reads the bundle in web/data/, written by
# `poetry run forecaster export-web --release YYYY-MM` and committed for deploys.
# To see live pipeline output while developing, point these at the repo's data/
# folder in web/.env.local instead (paths are relative to web/):
# RAW_DATA_DIR=../data/raw
# PROCESSED_DATA_DIR=../data/processed

# Not used yet: Postgres connection for a future src/lib/db.ts (read-only). The
# deployed app needs no database.
# DATABASE_URL=postgres://user:password@localhost:5432/home_value_forecaster
